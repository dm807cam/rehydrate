{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reHydrate",
  "version": "1.0.2",
  "identifier": "app.rehydrate.desktop",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 reHydrate contributors",
    "shortDescription": "iTunes for reMarkable — privacy-respecting USB sync",
    "longDescription": "A desktop app that mirrors a reMarkable 2 over USB into a content-addressed local library with full version history. No cloud, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "entitlements": null,
      "providerShortName": null,
      "signingIdentity": "-"
    }
  }
}
